# 이 파일을 복사해 .env 로 저장한다. .env 는 커밋하지 않는다.

DATABASE_URL=sqlite:///./demo.db
# MySQL: mysql+pymysql://user:password@localhost:3306/demo
# PostgreSQL: postgresql+psycopg://user:password@localhost:5432/demo

SECRET_KEY=change-me-to-a-long-random-value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]

# 0이면 목록 캐시를 끈다. 운영 예시는 5000(5초).
CACHE_TTL_MS=0
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=1000000

# 비우면 메일은 로그만 남긴다.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=noreply@example.com

# 비우면 AI 답변은 문서 발췌(mock)만 사용한다.
OPENAI_API_KEY=
LLM_PROVIDER=mock
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:12b

GOOGLE_CLIENT_ID=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/callback
